# Copy to .env for local development. Never commit .env.
# On Streamlit Community Cloud, set the same keys in st.secrets instead.

# Identification for the User-Agent: SignalCheck/<version> (+<repo-url>; <contact-email>)
SIGNALCHECK_REPO_URL=https://github.com/pragmatic-philosopher09/signal-check
SIGNALCHECK_CONTACT_EMAIL=

# Optional LLM narration (COPILOT_BRIEF.md section 9.1). The LLM only rewrites the validated
# findings; with no provider/key, or when its text fails validation, cards show template text.
# LLM_PROVIDER: "openai" (any OpenAI-compatible Chat Completions endpoint). Leave empty to disable.
LLM_PROVIDER=
LLM_API_KEY=
# Model id as the endpoint expects it; defaults to narration.default_model in config.yaml.
LLM_MODEL=
# Defaults to https://api.openai.com/v1. Other OpenAI-compatible gateways work too, e.g.
# GitHub Models (https://models.github.ai/inference, LLM_MODEL=openai/gpt-4o-mini) or
# OpenRouter (https://openrouter.ai/api/v1).
LLM_BASE_URL=

# Reddit Data API (OAuth app-only "script" app; needs Reddit's approval, non-commercial use).
# Unset -> the Reddit card reads "Reddit disabled (API credentials not configured)".
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Optional: your Reddit username, appended to the User-Agent as "(by /u/<name>)".
REDDIT_USERNAME=

# X API (disabled by default; pay-per-use with a hard budget cap).
# ENABLE_X overrides sources.x in config.yaml. Spend is tracked in <cache.dir>/x_spend_ledger.json;
# requests that would push total spend above X_MAX_SPEND_USD (USD) are refused.
ENABLE_X=false
X_BEARER_TOKEN=
X_MAX_SPEND_USD=5
